<div class="container mt-5">


  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="mb-1">Home</h1>
      <p class="text-muted mb-0">
        Welcome <strong><%= current_user.email %></strong>
      </p>
    </div>

    <%= button_to "Logout",
                  destroy_user_session_path,
                  method: :delete,
                  class: "btn btn-outline-danger" %>
  </div>

  <hr>

 
  <div class="card shadow-sm mt-4">
    <div class="card-body">

      <h2 class="card-title mb-4">Users</h2>

      <%= form_with url: root_path,
                    method: :get,
                    data: { controller: "search" } do |form| %>

        <div class="input-group mb-2">

          <%= form.text_field :search,
                              value: params[:search],
                              placeholder: "Search by email",
                              class: "form-control",
                              data: {
                                turbo: true,
                                search_target: "input",
                                action: "input->search#validate"
                              } %>

          <%= form.submit "Search",
                          class: "btn btn-primary" %>

        </div>

        <span data-search-target="error"
              class="text-danger"></span>

      <% end %>

     
      <%= turbo_frame_tag "users" do %>
        <%= render "users", users: @users %>
      <% end %>

    </div>
  </div>

</div>