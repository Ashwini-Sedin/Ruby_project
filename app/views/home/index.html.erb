
<nav class="navbar navbar-expand-lg" style="background-color: #001f3f;">
  <div class="container-fluid">

    <%= link_to "Welcome🙏",
                root_path,
                class: "navbar-brand text-white" %>

    <% if user_signed_in? %>
      <div class="dropdown ms-auto">

        <a href="#"
           class="nav-link text-white dropdown-toggle user-menu"
           data-bs-toggle="dropdown"
           aria-expanded="false">
          <%= current_user.username %>
        </a>

        <ul class="dropdown-menu dropdown-menu-end user-dropdown">
          <li>
           <%= link_to current_user.email, "#", class: "dropdown-item" %>
          </li>

          <li>
            <%= link_to "Logout",
                        destroy_user_session_path,
                        data: { turbo_method: :delete },
                        class: "dropdown-item" %>
          </li>
        </ul>

      </div>
    <% end %>

  </div>
</nav>


<div class="container mt-5">

  

  <hr>

  <div class="card shadow-sm mt-4">
    <div class="card-body">

      <h2 class="card-title mb-4">Users</h2>

      <%= form_with url: root_path,
                    method: :get,
                    data: { controller: "search" } do |form| %>

        <div class="input-group mb-2">

          <%= form.text_field :search,
                              value: params[:search],
                              placeholder: "Search by email",
                              class: "form-control",
                              data: {
                                turbo: true,
                                search_target: "input",
                                action: "input->search#validate"
                              } %>

          <%= form.submit "Search",
                          class: "btn btn-primary" %>

        </div>

        <span data-search-target="error"
              class="text-danger"></span>

      <% end %>

      <%= turbo_frame_tag "users" do %>
        <%= render "users", users: @users %>
      <% end %>

    </div>
  </div>

</div>