<div class="table-responsive">
  <table class="table table-striped table-hover align-middle">

    <thead class="table-dark">
      <tr>
        <th>ID</th>
        <%# <th>Username</th>
        <th>First Name</th>
        <th>Last Name</th> %>
        <th>Email</th>
        <th>Action</th>
      </tr>
    </thead>

    <tbody>
      <% users.each do |user| %>

        <tr id="<%= dom_id(user) %>">

          <td>
            <%= user.id %>
          </td>

          <%# <td>
            <%= user.username %>
          <%# </td> %>

          <%# <td>
            <%= user.first_name %>
          <%# </td> %> 

          <%# <td>
            <%= user.last_name %> 
          <%# </td>  %>

          <td>
            <%= user.email %>
          </td>

          <td>
            <%= button_to "Delete",
                delete_user_path(user),
                method: :delete,
                class: "btn btn-sm btn-danger",
                data: {
                  turbo_confirm: "Are you sure?"
                } %>
          </td>

        </tr>

      <% end %>
    </tbody>

  </table>
</div>